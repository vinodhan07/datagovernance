# PostgreSQL Connection URL (Stores metadata, integrations, catalog, scan findings)
POSTGRES_URL=postgresql://myuser:mypassword@localhost:5432/dataguard

# Fernet symmetric encryption key for integrations credentials (databases, github tokens)
# Generate a new one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=Ausg04GsE713RPy45RtBkJvyocY_wPClBmctxQM8kNk=

# Application Environment (development, production)
APP_ENV=development

# Source MariaDB Connection Defaults (for the extract pipeline)
MARIADB_USER=root
MARIADB_PASS=root123
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307

# Spline Data Lineage Producer & consumer API URLs
SPLINE_PRODUCER_URL=http://localhost:8080/producer
SPLINE_CONSUMER_URL=http://localhost:8080/consumer
SPLINE_WEB_UI_URL=http://localhost:9090

# OpenMetadata catalog (generate JWT from OM UI: Settings → Bots → ingestion-bot)
